{
  "name": "website",
  "main": "worker.js",
  // Pin the project to Bera1hoes@gmail.com's Cloudflare account. Wrangler
  // otherwise targets whichever account the active `wrangler login` token
  // belongs to — with this set, a wrong login fails loudly instead of
  // deploying a stray copy of the Worker to the wrong account.
  "account_id": "4765286eb9d7748fce8703d383e6ea2f",
  "compatibility_date": "2025-05-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Assets normally serve BEFORE the Worker runs, which would let /Arena and
    // /Arena.html bypass the worker's ARENA_PASSWORD gate. Force those paths
    // through the Worker first. (Other casings, e.g. /arena, don't match the
    // asset manifest and always reach the Worker.)
    "run_worker_first": ["/Arena", "/Arena.html", "/Arena/"]
  },
  "services": [
    { "binding": "USERINFO_WORKER", "service": "userinfo-worker" }
  ],
  "kv_namespaces": [
    {
      "binding": "CHART_DATA",
      "id": "1b5aa7e017d2466c9b614b551f4ac467",
      "preview_id": "8dbd710fef3448bca00cc7ad2753a248"
    },
    // Guild rosters captured by SwissKnife (POST /guild), read by Win Prediction.
    // Write key is the ROSTER_WRITE_KEY secret (`wrangler secret put ROSTER_WRITE_KEY`).
    {
      "binding": "ROSTERS",
      "id": "34c42bd61ddf47509052a9194e988fc7"
    }
  ]
}
